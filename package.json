{
  "name": "extractor-builder",
  "version": "2.0.0",
  "description": "stripmine — paste a Lovable URL, get a self-contained static site (HTML + CSS + JS + assets).",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"nodemon server/index.js\" \"vite --config client/vite.config.js\"",
    "dev:api": "nodemon server/index.js",
    "dev:web": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "test": "node _test.js",
    "postinstall": "npx puppeteer browsers install chrome || exit 0"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "puppeteer": "^23.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.4",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
