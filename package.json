{
  "name": "extractor-builder",
  "version": "2.0.0",
  "description": "stripmine — paste a Lovable URL, get a self-contained static site (HTML + CSS + JS + assets).",
  "type": "commonjs",
  "scripts": {
    "predev": "node scripts/kill-dev-ports.js",
    "dev": "concurrently -n api,web -c blue,magenta \"nodemon --config nodemon.json server/index.js\" \"vite --config client/vite.config.js\"",
    "dev:api": "nodemon --config nodemon.json server/index.js",
    "dev:web": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "test": "node _test.js",
    "verify:ingest": "node scripts/verify-ingest-consumption.js",
    "test:contracts": "node contracts/validation/harness.js",
    "test:kernel": "node compiler/test/kernel.test.js",
    "test:workspace": "node compiler/test/workspace.test.js",
    "test:decision": "node compiler/test/decision.test.js",
    "test:policy": "node compiler/test/policy.test.js",
    "test:plugin": "node compiler/test/plugin.test.js",
    "test:knowledge": "node compiler/test/knowledge.test.js",
    "test:rulepack": "node compiler/test/rulepack.test.js",
    "test:features": "node compiler/test/features.test.js",
    "test:ndg": "node compiler/test/ndg.test.js",
    "test:layout": "node compiler/test/layout.test.js",
    "test:constraint": "node compiler/test/constraint.test.js",
    "test:component": "node compiler/test/component.test.js",
    "test:token": "node compiler/test/token.test.js",
    "test:semantic": "node compiler/test/semantic.test.js",
    "test:responsive": "node compiler/test/responsive.test.js",
    "test:accessibility": "node compiler/test/accessibility.test.js",
    "test:resolved": "node compiler/test/resolved.test.js",
    "test:emit": "node compiler/test/emit.test.js",
    "test:compile": "node compiler/test/compile.test.js",
    "test:artifacts": "node compiler/test/artifacts.test.js",
    "test:scalability": "node server/scalability/test/run-all.js",
    "bench:scalability": "node server/scalability/test/bench.js",
    "test:api-contract": "node server/api/v1/contract-test.js",
    "test:phase1": "npm run test:contracts",
    "test:phase2": "npm run test:kernel",
    "test:phase3": "npm run test:workspace",
    "test:phase4": "npm run test:decision",
    "test:phase5": "npm run test:policy",
    "test:phase6": "npm run test:plugin",
    "test:phase7": "npm run test:knowledge",
    "test:phase8": "npm run test:rulepack",
    "test:phase9": "npm run test:features",
    "test:phase10": "npm run test:ndg",
    "test:phase11": "npm run test:layout",
    "test:phase11b": "npm run test:constraint",
    "test:phase12": "npm run test:component",
    "test:phase13": "npm run test:token",
    "test:phase14": "npm run test:semantic",
    "test:phase15": "npm run test:responsive",
    "test:phase16": "npm run test:accessibility",
    "test:phase17": "npm run test:resolved",
    "test:phase18": "npm run test:emit",
    "test:phase19": "npm run test:compile",
    "test:phase20": "npm run test:artifacts",
    "postinstall": "npx puppeteer browsers install chrome || exit 0"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "js-beautify": "^1.15.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "puppeteer": "^23.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.4",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
