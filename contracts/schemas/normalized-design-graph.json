{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "contractId": "NormalizedDesignGraph",
  "suiteVersion": "1.0.0",
  "title": "NormalizedDesignGraph",
  "description": "Stable node/edge graph. Paints/geometry as data, not semantic conclusions.",
  "type": "object",
  "required": ["contractId", "suiteVersion", "graphId", "nodes", "edges"],
  "properties": {
    "contractId": { "const": "NormalizedDesignGraph" },
    "suiteVersion": { "type": "string" },
    "graphId": { "type": "string", "minLength": 1 },
    "rawDocumentId": { "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceNodeId": { "type": ["string", "null"] },
          "visible": { "type": "boolean" },
          "name": { "type": ["string", "null"] },
          "type": { "type": ["string", "null"] },
          "box": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number" },
              "height": { "type": "number" }
            },
            "additionalProperties": false
          },
          "paints": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "geometry": { "type": "object", "additionalProperties": true },
          "attributes": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["parent", "order", "other"] },
          "index": { "type": "integer" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
