{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "contractId": "ProvenanceBundle",
  "suiteVersion": "1.0.0",
  "title": "ProvenanceBundle",
  "description": "Bindings source ↔ IR ↔ emit ↔ decisions.",
  "type": "object",
  "required": ["contractId", "suiteVersion", "bundleId", "bindings"],
  "properties": {
    "contractId": { "const": "ProvenanceBundle" },
    "suiteVersion": { "type": "string" },
    "bundleId": { "type": "string", "minLength": 1 },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["bindingId"],
        "properties": {
          "bindingId": { "type": "string", "minLength": 1 },
          "sourceNodeId": { "type": "string" },
          "irNodeId": { "type": "string" },
          "emitAnchorId": { "type": "string" },
          "decisionId": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
