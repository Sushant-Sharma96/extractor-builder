{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "contractId": "QualityReport",
  "suiteVersion": "1.0.0",
  "title": "QualityReport",
  "description": "Multi-axis score slots (RFC-001 §7), violations, traces. Scoring logic is Phase 24.",
  "type": "object",
  "required": ["contractId", "suiteVersion", "reportId", "scores", "violations"],
  "properties": {
    "contractId": { "const": "QualityReport" },
    "suiteVersion": { "type": "string" },
    "reportId": { "type": "string", "minLength": 1 },
    "policyProfileId": { "type": "string" },
    "scores": {
      "type": "object",
      "properties": {
        "pixelFidelity": { "type": ["number", "null"] },
        "layoutFidelity": { "type": ["number", "null"] },
        "semanticScore": { "type": ["number", "null"] },
        "responsiveScore": { "type": ["number", "null"] },
        "accessibilityScore": { "type": ["number", "null"] },
        "animationFidelity": { "type": ["number", "null"] },
        "interactionCompleteness": { "type": ["number", "null"] },
        "tokenQuality": { "type": ["number", "null"] },
        "domComplexity": { "type": ["number", "null"] },
        "cssComplexity": { "type": ["number", "null"] },
        "performance": { "type": ["number", "null"] },
        "maintainability": { "type": ["number", "null"] },
        "confidence": { "type": ["number", "null"] },
        "recoveryRate": { "type": ["number", "null"] },
        "provenanceCoverage": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warn", "error"] },
          "message": { "type": "string" },
          "subject": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "decisionTraceRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recoveryNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string" },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "fallbackNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string" },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
