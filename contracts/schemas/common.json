{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "contractId": "common",
  "suiteVersion": "1.0.0",
  "$id": "compiler-contract-suite/common",
  "definitions": {
    "NodeRef": {
      "type": "string",
      "minLength": 1,
      "description": "Stable node id within a compile job (see rules/shared-node-identity.md)."
    },
    "Subject": {
      "oneOf": [
        { "$ref": "#/definitions/NodeRef" },
        {
          "type": "array",
          "items": { "$ref": "#/definitions/NodeRef" },
          "minItems": 1
        },
        {
          "type": "object",
          "required": ["nodes"],
          "properties": {
            "nodes": {
              "type": "array",
              "items": { "$ref": "#/definitions/NodeRef" },
              "minItems": 1
            },
            "edges": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ScoreBreakdown": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "description": "Named score components; algebra is Phase 4/27."
    },
    "ScoreEntry": {
      "type": "object",
      "required": ["candidateId", "value"],
      "properties": {
        "candidateId": { "type": "string" },
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "breakdown": { "$ref": "#/definitions/ScoreBreakdown" }
      },
      "additionalProperties": false
    },
    "BoundingBox": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      },
      "additionalProperties": false
    },
    "ProducerRef": {
      "type": "object",
      "properties": {
        "engineId": { "type": "string" },
        "packId": { "type": "string" },
        "ruleId": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
