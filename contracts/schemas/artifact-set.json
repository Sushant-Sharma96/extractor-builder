{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "contractId": "ArtifactSet",
  "suiteVersion": "1.0.0",
  "title": "ArtifactSet",
  "description": "Emitted artifact map envelope. Not HTML authoring rules.",
  "type": "object",
  "required": ["contractId", "suiteVersion", "artifactSetId", "artifacts"],
  "properties": {
    "contractId": { "const": "ArtifactSet" },
    "suiteVersion": { "type": "string" },
    "artifactSetId": { "type": "string", "minLength": 1 },
    "emitPlanId": { "type": "string" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "id"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["html", "css", "js", "map", "other"]
          },
          "id": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string" },
          "pathHint": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
