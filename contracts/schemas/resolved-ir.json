{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "contractId": "ResolvedIR",
  "suiteVersion": "1.0.0",
  "title": "ResolvedIR",
  "description": "Post-arbitration compile truth. Commitment markers authorize lowering.",
  "type": "object",
  "required": ["contractId", "suiteVersion", "resolvedId", "slices"],
  "properties": {
    "contractId": { "const": "ResolvedIR" },
    "suiteVersion": { "type": "string" },
    "resolvedId": { "type": "string", "minLength": 1 },
    "decisionIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stageId", "sliceId", "committed"],
        "properties": {
          "stageId": { "type": "string" },
          "sliceId": { "type": "string" },
          "committed": { "type": "boolean" },
          "nodeIds": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
