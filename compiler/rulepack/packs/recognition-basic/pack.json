  "priority": 30,
  "allowedPolicies": ["*"],
  "knowledgeRefs": [
    "feature:recognition.signals",
    "pattern:block.generic-block",
    "pattern:block.button-like",
    "pattern:block.card-like",
    "pattern:block.container-like",
    "pattern:block.text-block",
    "pattern:block.image-block",
    "pattern:block.divider",
    "pattern:block.section",
    "pattern:block.grid",
    "pattern:block.stack",
    "pattern:block.list"
  ],
  "dependencies": [
    { "packId": "feature.extract", "versionRange": "^1.0.0", "required": false }
  ],
  "rules": [
    {
      "ruleId": "recognition.basic.blockKind",
      "question": "recognition.blockKind",
