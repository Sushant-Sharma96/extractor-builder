    "produces": ["Hypothesis", "Evidence", "Candidate"],
    "requiredFacts": ["ndg.graph"],
    "optionalFacts": ["ndg.node", "semantic.ir", "accessibility.ir"],
    "emittedIR": [],
    "acceptedQuestions": ["a11y.name", "a11y.role"],
    "allowedPolicies": ["*"],
    "requiredCapabilities": [],
    "incompatiblePlugins": [],
    "estimatedCost": 5,
    "estimatedMemory": 2048,
    "timeout": 15000,
    "retries": 0,
    "crashIsolation": "try_catch",
    "rollbackSupport": "workspace_tx",
    "contractSuiteVersion": "1.0.0"
  }
