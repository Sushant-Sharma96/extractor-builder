{
  "packId": "accessibility.detect",
  "version": "1.0.0",
  "suiteVersion": "1.0.0",
  "description": "Phase 16 — accessibility name/role proposers (never commit Decisions)",
  "priority": 46,
  "allowedPolicies": ["*"],
  "knowledgeRefs": [],
  "dependencies": [],
  "rules": [
    {
      "ruleId": "accessibility.detect.name",
      "question": "a11y.name",
      "matcherRef": "a11y.ambiguous",
      "priorityBand": "P2",
      "description": "Propose accessible name candidates under ambiguity or missing names"
    },
    {
      "ruleId": "accessibility.detect.role",
      "question": "a11y.role",
      "matcherRef": "a11y.focus",
      "priorityBand": "P3",
      "description": "Propose access-role intents for interactive / landmark nodes (not ARIA attrs)"
    }
  ],
  "plugin": {
    "id": "rulepack.accessibility.detect",
    "version": "1.0.0",
    "engineType": "proposer",
    "phaseAffinity": "mid",
    "determinism": "pure",
    "reads": ["Fact", "Evidence", "IrSlice"],
    "writes": ["Hypothesis", "Evidence"],
    "creates": ["Hypothesis", "Evidence"],
    "destroys": [],
